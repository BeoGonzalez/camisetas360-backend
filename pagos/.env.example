# Variables de entorno de ms-pago. Copia este archivo a pagos/.env para correr el servicio desde el IDE
# o con ./mvnw spring-boot:run (Spring lo lee al arrancar; pagos/.env no se versiona).
# Formato KEY=valor, sin comillas. En AWS estas mismas variables las registra el deploy en la task
# definition de ECS: las credenciales desde secrets de GitHub y el resto desde variables de GitHub.

# --- Servidor -------------------------------------------------------------------------------------
SERVER_PORT=8087
SPRING_APPLICATION_NAME=pagos
LOG_LEVEL_PAGOS=INFO

# --- Base de datos (Postgres local de docker compose: pago-postgres en 127.0.0.1:5438) -------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5438/camisetas360_pago
SPRING_DATASOURCE_USERNAME=pago
# Credencial (secret DB_PASSWORD en AWS). Debe coincidir con PAGO_POSTGRES_PASSWORD del .env de la raiz.
SPRING_DATASOURCE_PASSWORD=reemplazar
PAGO_DB_SCHEMA=pago
JPA_SHOW_SQL=false

# --- Kafka ----------------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
OUTBOX_DELAY_MS=2000

# --- Antifraude -----------------------------------------------------------------------------------
ANTIFRAUDE_MAX_INTENTOS=2
ANTIFRAUDE_VENTANA_SEGUNDOS=10
ANTIFRAUDE_BLOQUEO_MINUTOS=30
# Credencial (secret ANTIFRAUDE_SECRETO_HASH en AWS).
ANTIFRAUDE_SECRETO_HASH=reemplazar

# --- Webpay Plus (Transbank) ----------------------------------------------------------------------
# Integracion: https://webpay3gint.transbank.cl / Produccion: https://webpay3g.transbank.cl
WEBPAY_BASE_URL=https://webpay3gint.transbank.cl
WEBPAY_CODIGO_COMERCIO=597055555532
# Credencial (secret WEBPAY_API_KEY en AWS). La de integracion esta en
# https://www.transbankdevelopers.cl/documentacion/como_empezar#ambientes
WEBPAY_API_KEY=reemplazar
WEBPAY_RETURN_URL=http://localhost:8087/api/v1/pago/webpay/retorno
WEBPAY_RESULTADO_URL=http://localhost:4200/pago/resultado
WEBPAY_TIMEOUT=10s

# --- CORS (solo perfil local) ---------------------------------------------------------------------
CORS_ALLOWED_ORIGIN=http://localhost:*
