# ============================================================
# Camisetas360 / Pedidos360 - Variables de Entorno de Ejemplo
# Copiar este archivo como .env y ajustar valores locales
# ============================================================

# Correo (Mailpit local / SMTP)
MAIL_USERNAME=local
MAIL_PASSWORD=local
MAIL_FROM=orders@camisetas360.test

# RabbitMQ
RABBITMQ_USERNAME=camisetas360
RABBITMQ_PASSWORD=camisetas360_dev
RABBITMQ_VHOST=/camisetas360

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:*

# Microsoft Entra ID (opcional en desarrollo local)
ENTRA_ISSUER_URI=https://login.microsoftonline.com/e5372bf0-c5e3-4286-887c-79069f209c1f/v2.0
ENTRA_AUDIENCE=719c999d-0f57-4ad5-9bd9-a72be5ca07e0

# PostgreSQL - Orders
POSTGRES_DB=camisetas360
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders_dev_secret_change_me

# PostgreSQL - Catalog
CATALOG_POSTGRES_DB=camisetas360_catalog
CATALOG_POSTGRES_USER=catalog
CATALOG_POSTGRES_PASSWORD=catalog_dev_secret_change_me

# PostgreSQL - Auth
AUTH_POSTGRES_DB=camisetas360_auth
AUTH_POSTGRES_USER=auth
AUTH_POSTGRES_PASSWORD=auth_dev_secret_change_me

# PostgreSQL - Carrito
CARRITO_POSTGRES_DB=camisetas360_carrito
CARRITO_POSTGRES_USER=carrito
CARRITO_POSTGRES_PASSWORD=carrito_dev_secret_change_me

# PostgreSQL - Notifications
NOTIFICATIONS_POSTGRES_DB=camisetas360_notifications
NOTIFICATIONS_POSTGRES_USER=notifications
NOTIFICATIONS_POSTGRES_PASSWORD=notifications_dev_secret_change_me

# PostgreSQL - Recommendation
RECOMMENDATION_POSTGRES_DB=camisetas360_recommendation
RECOMMENDATION_POSTGRES_USER=recommendation
RECOMMENDATION_POSTGRES_PASSWORD=recommendation_dev_secret_change_me

# PostgreSQL - Pago (ms-pago)
PAGO_POSTGRES_DB=camisetas360_pago
PAGO_POSTGRES_USER=pago
PAGO_POSTGRES_PASSWORD=pago_dev_secret_change_me

# Antifraude (ms-pago)
ANTIFRAUDE_SECRETO_HASH=super-secreto-antifraude-hmac-sha256-cambiar-en-produccion

# AI (Mistral AI para recommendation)
SPRING_AI_MISTRALAI_API_KEY=tu_api_key_local
